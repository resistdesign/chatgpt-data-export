{
  "name": "@resistdesign/chatgpt-data-export",
  "version": "0.2.0",
  "description": "Local-first Electron desktop app for resumable ChatGPT account archives",
  "type": "module",
  "bin": {
    "chatgpt-data-export-verify": "./dist/verify.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "electron .",
    "prestart": "yarn build",
    "dev": "yarn start",
    "verify": "node dist/verify.js",
    "preverify": "yarn build",
    "test": "yarn build && node --test dist/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "45.2.3",
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "main": "./dist/desktop/main.js"
}
